{
  "name": "casefile",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply casefile --local && wrangler dev",
    "deploy": "wrangler d1 migrations apply casefile --remote && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "node evals/run.ts"
  },
  "dependencies": {
    "agents": "0.26.0",
    "ai": "7.0.127",
    "workers-ai-provider": "4.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@cloudflare/workers-types": "5.20261004.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
