{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023",
      "esnext.disposable"
    ],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "test",
    "evals",
    "vitest.config.ts"
  ],
  "exclude": [
    "evals/run.ts"
  ]
}
